<% layout('layouts/boilerPlate') -%>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 2rem;
        }

        .filter {
        text-decoration: none;
        color: black;
        font-size: 20px;
            text-align: center;
            margin-top: 2rem;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .icons-container{
            display:flex;
            flex-wrap:wrap;
            gap:1rem;
        }

        .filter p {
            font-size: 0.5rem;
        }

.tax-info{
    display: none;
}
.tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin-top: 1.5rem;
    margin-left: 5rem;
    display: flex;
    align-items: center;
}

    </style>
